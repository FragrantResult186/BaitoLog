<?xml version="1.0" encoding="UTF-8"?>
<Context>
	<Resource
		name="jdbc/baitolog"
		auth="Container"
		type="javax.sql.DataSource"
		driverClassName="org.postgresql.Driver"
		url="${DB_URL}"
		username="${DB_USER}"
		password="${DB_PASSWORD}"
		maxTotal="5"
		maxIdle="2"
		minIdle="0"
		testOnBorrow="true"
		validationQuery="select 1"
	/>
</Context>
